interface OrbSceneProps {
  shellRef: React.RefObject<HTMLDivElement>;
}

const OrbScene: React.FC<OrbSceneProps> = ({ shellRef }) => {
  const reduced = usePrefersReducedMotion();
  const particleBase = 2600;
  const activeCount = useParticleCount(particleBase, 700);
  const orbGroupRef = React.useRef<THREE.Group | null>(null);
  const orbMeshRef = React.useRef<THREE.Mesh | null>(null);
  const glowMeshRef = React.useRef<THREE.Mesh | null>(null);
  const stateRef = React.useRef(0);
  const targetStateRef = React.useRef(0);
  const smoothedStateRef = React.useRef(0);

  const orbitGeom1 = React.useMemo(() => {
    const pts = new THREE.EllipseCurve(0, 0, 1.9, 1.9, 0, Math.PI * 2, false, 0).getPoints(140);
    return new THREE.BufferGeometry().setFromPoints(pts);
  }, []);
  const orbitLine1 = React.useMemo(
    () =>
      new THREE.Line(
        orbitGeom1,
        new THREE.LineBasicMaterial({
          color: new THREE.Color('#8b6bff'),
          transparent: true,
          opacity: 0.55
        })
      ),
    [orbitGeom1]
  );
  const orbitGeom2 = React.useMemo(() => {
    const pts = new THREE.EllipseCurve(0, 0, 2.4, 1.0, 0, Math.PI * 2, false, 0).getPoints(140);
    return new THREE.BufferGeometry().setFromPoints(pts);
  }, []);
  const orbitLine2 = React.useMemo(
    () =>
      new THREE.Line(
        orbitGeom2,
        new THREE.LineBasicMaterial({
          color: new THREE.Color('#34e0ff'),
          transparent: true,
          opacity: 0.48
        })
      ),
    [orbitGeom2]
  );
  const orbitGeom3 = React.useMemo(() => {
    const pts = new THREE.EllipseCurve(0, 0, 2.9, 0.7, 0, Math.PI * 2, false, 0).getPoints(140);
    return new THREE.BufferGeometry().setFromPoints(pts);
  }, []);
  const orbitLine3 = React.useMemo(
    () =>
      new THREE.Line(
        orbitGeom3,
        new THREE.LineBasicMaterial({
          color: new THREE.Color('#eeecff'),
          transparent: true,
          opacity: 0.28
        })
      ),
    [orbitGeom3]
  );

  const particleGeom = React.useMemo(() => {
    const g = new THREE.BufferGeometry();
    const base = new Float32Array(particleBase * 3);
    for (let i = 0; i < particleBase; i++) {
      const r = 0.8 + Math.random() * 1.6;
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.acos(2 * Math.random() - 1);
      base[i * 3 + 0] = r * Math.sin(phi) * Math.cos(theta);
      base[i * 3 + 1] = r * Math.sin(phi) * Math.sin(theta);
      base[i * 3 + 2] = r * Math.cos(phi);
    }
    g.setAttribute('position', new THREE.BufferAttribute(base, 3));
    g.setDrawRange(0, activeCount);
    return g;
  }, [activeCount]);

  React.useEffect(() => {
    particleGeom.setDrawRange(0, activeCount);
  }, [activeCount, particleGeom]);

  React.useEffect(() => {
    if (typeof window === 'undefined' || !window.MutationObserver) return;
    const shell = shellRef.current;
    if (!shell) return;
    const readState = () => {
      for (let i = 0; i < 4; i++) {
        if (shell.classList.contains(`hp-orb-state-${i}`)) {
          targetStateRef.current = i;
          return;
        }
      }
      targetStateRef.current = 0;
    };
    readState();
    const obs = new MutationObserver(() => readState());
    obs.observe(shell, { attributes: true, attributeFilter: ['class'] });
    return () => obs.disconnect();
  }, [shellRef]);

  useFrame(({ clock }) => {
    const t = reduced ? 0 : clock.elapsedTime;
    const lerpFactor = reduced ? 1 : 0.08;
    smoothedStateRef.current += (targetStateRef.current - smoothedStateRef.current) * lerpFactor;
    stateRef.current = smoothedStateRef.current;

    const s = smoothedStateRef.current;
    const violetW = Math.max(0, 1 - s / 3);
    const cyanW = Math.max(0, s / 3);
    const coreColor = new THREE.Color('#8b6bff').lerp(new THREE.Color('#34e0ff'), cyanW / (violetW + cyanW + 1e-6));
    const scaleBias = 0.88 + s * 0.08;

    if (orbGroupRef.current) {
      orbGroupRef.current.rotation.x = Math.sin(t * 0.35) * 0.25 + s * 0.1;
      orbGroupRef.current.rotation.y = t * (reduced ? 0.04 : 0.22);
      orbGroupRef.current.rotation.z = Math.cos(t * 0.28) * 0.18;
    }
    if (orbMeshRef.current) {
      const m = orbMeshRef.current.material as THREE.MeshStandardMaterial;
      m.emissive.copy(coreColor);
      m.color.copy(coreColor);
      m.emissiveIntensity = 0.55 + Math.sin(t * 2 + s) * 0.2 + s * 0.15;
      orbMeshRef.current.scale.setScalar(scaleBias + (reduced ? 0 : Math.sin(t * 1.7) * 0.035));
    }
    if (glowMeshRef.current) {
      const m = glowMeshRef.current.material as THREE.MeshBasicMaterial;
      m.color.copy(coreColor);
      m.opacity = 0.18 + s * 0.05 + (reduced ? 0 : Math.sin(t * 1.2) * 0.03);
      glowMeshRef.current.scale.setScalar(scaleBias * 1.55);
    }
  });

  return (
    <>
      <HomepageSceneLighting />
      <group ref={orbGroupRef}>
        <mesh ref={orbMeshRef}>
          <icosahedronGeometry args={[1.05, 2]} />
          <meshStandardMaterial
            color="#8b6bff"
            emissive="#8b6bff"
            emissiveIntensity={0.55}
            transparent
            opacity={0.92}
            metalness={0.3}
            roughness={0.25}
            flatShading
          />
        </mesh>
        <mesh ref={glowMeshRef}>
          <sphereGeometry args={[1.1, 32, 32]} />
          <meshBasicMaterial color="#8b6bff" transparent opacity={0.2} depthWrite={false} blending={THREE.AdditiveBlending} />
        </mesh>

        <lineSegments geometry={particleGeom}>
          <pointsMaterial
            size={0.028}
            sizeAttenuation
            color="#8b6bff"
            transparent
            opacity={0.65}
            depthWrite={false}
            blending={THREE.AdditiveBlending}
          />
        </lineSegments>
        <points geometry={particleGeom}>
          <pointsMaterial
            size={0.028}
            sizeAttenuation
            color="#8b6bff"
            transparent
            opacity={0.7}
            depthWrite={false}
            blending={THREE.AdditiveBlending}
          />
        </points>

        <group rotation={[Math.PI * 0.42, 0, 0]}>
          <primitive object={orbitLine1} dispose={null} />
        </group>
        <group rotation={[Math.PI * 0.55, Math.PI * 0.3, 0]}>
          <primitive object={orbitLine2} dispose={null} />
        </group>
        <group rotation={[Math.PI * 0.25, -Math.PI * 0.5, Math.PI * 0.1]}>
          <primitive object={orbitLine3} dispose={null} />
        </group>
      </group>
    </>
  );
};

