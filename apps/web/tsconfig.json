{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "outDir": "./dist",
    "rootDir": "../..",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@qvanta/types": ["../../packages/types/src"],
      "@qvanta/ui": ["../../packages/ui/src"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../packages/types/src/**/*",
    "../../packages/ui/src/**/*"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
